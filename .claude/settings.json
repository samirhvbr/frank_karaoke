{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_comment_perfil": "NO `model` KEY, ON PURPOSE (24/09/2026 — repodocs ADR-026). A pin written here cannot win: the account's server-managed settings outrank every local file. And `opus[1m]` was a version pin wearing a window suffix — the 1M variant existed only for the previous Opus, so every session was born on it while the catalog already offered the newer one. To pin a model again, NAME the version: \"model\": \"opus55\". The highest effortLevel a FILE accepts is 'xhigh'; use /effort max for a single session.",
  "effortLevel": "xhigh",
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "opus"
  },
  "permissions": {
    "_comment": "Permissoes do projeto - Flutter/Dart (frank_karaoke)",
    "defaultMode": "plan",
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(flutter analyze:*)",
      "Bash(flutter test:*)",
      "Bash(flutter doctor:*)",
      "Bash(flutter devices:*)",
      "Bash(flutter pub get:*)",
      "Bash(flutter pub outdated:*)",
      "Bash(flutter build apk:*)",
      "Bash(flutter run:*)",
      "Bash(dart analyze:*)",
      "Bash(dart format:*)",
      "Bash(dart fix --dry-run:*)",
      "Bash(dart pub get:*)",
      "Bash(dart run build_runner:*)",
      "Bash(adb devices:*)"
    ],
    "deny": [
      "Read(./android/key.properties)",
      "Read(./android/**/*.jks)",
      "Read(./android/**/*.keystore)",
      "Read(./**/.env)",
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push * --force*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fd:*)",
      "Bash(curl * | sh:*)",
      "Bash(curl * | bash:*)",
      "Bash(wget * | sh:*)",
      "Bash(wget * | bash:*)"
    ],
    "ask": [
      "Bash(sudo:*)",
      "Bash(flutter pub upgrade:*)",
      "Bash(flutter pub add:*)",
      "Bash(flutter clean:*)",
      "Bash(dart pub upgrade:*)"
    ]
  }
}
